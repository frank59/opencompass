# 仓库根 .dockerignore — 配合 opencompass-app/Dockerfile 使用
# 构建时排除不必要文件，加速构建、减小上下文

# Git
.git
.gitignore
.gitattributes

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 测试产物（不进镜像）
tests/
.opencompass-app-test/

# 开发者脚本（不进镜像 — 容器内运行服务即可）
opencompass-app/scripts/

# 数据 / 大文件（不进镜像 — 数据通过 -v 挂载）
data/
*.zip
*.tar.gz
*.parquet

# 文档（运行时不需要）
docs/
README*.md
*.md

# Docker 自身
Dockerfile
.dockerignore
docker-compose*.yml

# 已有 venv / build 产物
venv/
.venv/
build/
dist/
*.egg

# CI / 配置
.github/
.pre-commit-config*.yaml
.codespellrc
.owners.yml

# Notebook / scratch
*.ipynb
*.log